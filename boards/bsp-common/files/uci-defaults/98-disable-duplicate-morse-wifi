#!/bin/sh
. /lib/functions.sh

# Fix wireless configurations for Morse devices
# Remove duplicate wifi-device sections based on path and type
# When duplicates are found (same path), keep only the 'morse' type

DEVICES_TO_REMOVE=""

# Collect all device paths and types
collect_device_info() {
	local device_config="$1"
	local type path

	config_get type "$device_config" type
	config_get path "$device_config" path

	# Skip if no path is set
	[ -n "$path" ] || return 0

	# Store device info: path|type|device_name
	DEVICE_INFO="${DEVICE_INFO}${path}|${type}|${device_config}
"
}

# Find and mark duplicates for removal
find_duplicates() {
	local current_path current_type current_device
	local check_path check_type check_device

	# Process each device entry
	echo "$DEVICE_INFO" | while IFS='|' read -r current_path current_type current_device; do
		[ -n "$current_path" ] || continue

		# Check if this path appears multiple times
		echo "$DEVICE_INFO" | while IFS='|' read -r check_path check_type check_device; do
			[ -n "$check_path" ] || continue

			# If same path but different device name
			if [ "$current_path" = "$check_path" ] && [ "$current_device" != "$check_device" ]; then
				# If current device is NOT morse, mark it for removal
				if [ "$current_type" != "morse" ]; then
					echo "$current_device"
				fi
			fi
		done
	done | sort -u
}

remove_wifi_iface_by_device() {
	local iface_config="$1"
	local device_config="$2"
	local device

	config_get device "$iface_config" device

	if [ "$device" = "$device_config" ]; then
		uci -q delete "wireless.$iface_config"
	fi
}

# Load wireless configuration
config_load wireless

# Collect all device information
DEVICE_INFO=""
config_foreach collect_device_info wifi-device

# Find devices to remove (non-morse duplicates)
DEVICES_TO_REMOVE=$(find_duplicates)

# Remove duplicate devices and their associated interfaces
for device in $DEVICES_TO_REMOVE; do
	# Remove all wifi-iface sections associated with this device
	config_foreach remove_wifi_iface_by_device wifi-iface "$device"

	# Remove the wifi-device section itself
	uci -q delete "wireless.$device"
done

# Commit changes if any were made
[ -n "$DEVICES_TO_REMOVE" ] && uci commit wireless

exit 0

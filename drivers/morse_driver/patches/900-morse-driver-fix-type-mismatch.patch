-	int len = sizeof(word);
+	u8 buf[4];
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 15, 0)
+	int i;
+#endif
 
 	/* Mask to look at only non-crc bits in both metadata word and delimiters */
